# ---------------------------------------------------------------------------
# hiyuki-agent — Python + Hermes runtime
# ---------------------------------------------------------------------------

# --- Secrets (SOPS/age) ----------------------------------------------------
# Never commit plaintext secrets. Encrypted blobs and example files are split
# so that the example template is committable while real values never are.
.env
.env.*
!.env.sops.example
*.sops
*.sops.yaml
*.enc

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
wheels/
*.manifest
*.spec

# --- Virtual environments ----------------------------------------------------
# The Hermes venv lives OUTSIDE the Hermes checkout (decision D-150) and is
# never committed.
.venv/
venv/
env/
ENV/
.uv/

# --- Test / tool caches -------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Hermes runtime state -----------------------------------------------------
# SQLite state.db is Hermes-native session state (decision D-146). Never commit.
state.db
state.db-wal
state.db-shm
*.db
*.db-wal
*.db-shm

# --- Local Hermes checkout (dependency git, decision D-86) --------------------
.runtime/
.hermes/
.hermes-agent/

# --- Node (toolchain hygiene) -------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# --- OS / editor ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~